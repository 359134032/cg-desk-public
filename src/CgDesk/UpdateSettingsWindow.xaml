<Window x:Class="CgDesk.UpdateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新源设置" Width="620" Height="500" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource InkBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="更新源" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="使用当前项目的 GitHub Releases" Click="GitHub_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Text="优先使用国内可达的发布地址；主源失败时自动尝试备用源。地址由发布者提供，尚未配置时不会发起网络检查。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="主清单地址（HTTPS）"/>
                <TextBox x:Name="PrimaryBox" Margin="0,6,0,14" AutomationProperties.Name="主更新清单地址"/>
                <TextBlock Text="备用清单地址（选填）"/>
                <TextBox x:Name="BackupBox" Margin="0,6,0,14" AutomationProperties.Name="备用更新清单地址"/>
                <TextBlock Text="更新通道"/>
                <CheckBox x:Name="ChannelBox" Content="接收测试版（含预发布）" Style="{StaticResource Switch}" Margin="0,8,0,6"/>
                <TextBlock Text="关闭时仅接收稳定版。" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                <TextBlock Text="每个清单内可以配置多个下载镜像。仅接受发布者签名，切换地址不会改变可信发布者。下载后保留 ZIP，由你选择安装时间。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button Content="保存" IsDefault="True" Click="Save_Click" MinWidth="80" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </Grid>
</Window>
